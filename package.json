{
  "name": "todo-cat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "qa": "bash scripts/qa.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "tsx scripts/db-reset.ts",
    "test:e2e": "playwright test",
    "db:seed": "tsx --conditions=react-server scripts/seed.mts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/mastra": "1.1.6",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@copilotkit/react-core": "1.77.0",
    "@copilotkit/runtime": "1.77.0",
    "@libsql/client": "^0.18.0",
    "@mastra/core": "1.74.0",
    "@mastra/libsql": "1.25.0",
    "@mastra/memory": "1.35.0",
    "@todo-cat/contract": "*",
    "better-auth": "1.7.7",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "contract",
    "cli"
  ]
}
